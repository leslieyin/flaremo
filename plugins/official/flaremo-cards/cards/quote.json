{
  "specVersion": 1,
  "root": {
    "type": "column",
    "style": {
      "minHeight": "100%",
      "padding": 32,
      "background": { "light": "#faf9f5", "dark": "#18181b" },
      "color": { "light": "#1f1e1d", "dark": "#f5f3ef" },
      "borderWidth": 1,
      "borderColor": { "light": "#e8e4dc", "dark": "#2a2a2d" },
      "borderRadius": 8
    },
    "children": [
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "space-between",
          "align": "start"
        },
        "children": [
          {
            "type": "text",
            "text": "“",
            "style": {
              "opacity": 0.3,
              "font": {
                "family": "serif",
                "size": 46,
                "weight": 700,
                "lineHeight": 0.8,
                "color": "brand.500"
              }
            }
          },
          {
            "type": "text",
            "text": "{date}",
            "style": {
              "font": {
                "size": 11,
                "color": { "light": "#a1a1aa", "dark": "#71717a" }
              }
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "{body}",
        "style": {
          "flex": 1,
          "marginTop": 14,
          "font": {
            "family": "serif",
            "size": 16,
            "lineHeight": 1.8
          }
        }
      },
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "end",
          "align": "center",
          "marginTop": 20
        },
        "children": [
          {
            "type": "spacer",
            "style": {
              "width": 20,
              "height": 1,
              "background": { "light": "#d4cfc5", "dark": "#3f3f46" },
              "opacity": 0.8
            }
          }
        ]
      }
    ]
  }
}
