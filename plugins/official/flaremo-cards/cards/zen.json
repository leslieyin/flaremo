          "clamp": 12,
          "overflow": "hidden",
          "font": {
            "family": "serif",
            "size": 15.5,
            "lineHeight": 2.0
          }
        }
      },
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "center",
          "align": "center",
          "marginTop": 18
        },
        "children": [
          {
            "type": "spacer",
            "style": {
              "width": 28,
              "height": 1,
              "background": { "light": "#b8b2a5", "dark": "#4a4c4f" },
