    "style": {
      "height": "100%",
      "padding": 34,
      "background": { "light": "#f6f4ee", "dark": "#161718" },
      "color": { "light": "#21201d", "dark": "#f2eee5" },
      "borderWidth": 1,
      "borderColor": { "light": "#e5e1d5", "dark": "#27292b" },
      "borderRadius": 4,
      "overflow": "hidden"
