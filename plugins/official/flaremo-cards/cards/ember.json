{
  "specVersion": 1,
  "root": {
    "type": "column",
    "style": {
      "height": "100%",
      "background": { "light": "#fdf8f4", "dark": "#1a1614" },
      "color": { "light": "#2c1d16", "dark": "#faefe8" },
      "borderWidth": 1,
      "borderColor": { "light": "#f4e7dd", "dark": "#36261f" },
      "borderRadius": 8,
      "overflow": "hidden"
    },
    "children": [
      {
        "type": "column",
        "style": {
          "height": 2,
          "background": "brand.500",
          "opacity": 0.8
        }
      },
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "space-between",
          "align": "center",
          "paddingX": 28,
          "paddingTop": 22
        },
        "children": [
          {
            "type": "spacer",
            "style": {
              "width": 5,
              "height": 5,
              "borderRadius": 9999,
              "background": "brand.500",
              "opacity": 0.75
            }
          },
          {
            "type": "text",
            "text": "{date}",
            "style": {
              "font": {
                "size": 11,
                "color": { "light": "#9a6b52", "dark": "#c2957e" }
              }
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "{body}",
        "style": {
          "flex": 1,
          "paddingX": 28,
          "marginTop": 20,
          "clamp": 13,
          "overflow": "hidden",
          "font": {
            "size": 15,
            "lineHeight": 1.88
          }
        }
      },
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "end",
          "align": "center",
          "paddingX": 28,
          "paddingBottom": 22
        },
        "children": [
          {
            "type": "spacer",
            "style": {
              "width": 20,
              "height": 1,
              "background": "brand.500",
              "opacity": 0.5
            }
          }
        ]
      }
    ]
  }
}
