{
  "specVersion": 1,
  "root": {
    "type": "column",
    "style": {
      "minHeight": "100%",
      "padding": 32,
      "background": { "light": "#faf9f6", "dark": "#18181b" },
      "color": { "light": "#27272a", "dark": "#f4f4f5" },
      "borderWidth": 1,
      "borderColor": { "light": "#e8e5df", "dark": "#27272a" },
      "borderRadius": 8
    },
    "children": [
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "end",
          "align": "center"
        },
        "children": [
          {
            "type": "text",
            "text": "{date}",
            "style": {
              "font": {
                "size": 11,
                "color": { "light": "#a1a1aa", "dark": "#71717a" }
              }
            }
          }
