            "size": 15,
            "lineHeight": 1.8
          }
        }
      },
      {
        "type": "row",
        "style": {
          "width": "100%",
          "align": "center",
          "marginTop": 24
        },
        "children": [
          {
            "type": "spacer",
            "style": {
              "width": 20,
              "height": 1,
              "background": { "light": "#d4d4d8", "dark": "#3f3f46" },
              "opacity": 0.8
            }
          }
        ]
      }
