{
  "specVersion": 1,
  "root": {
    "type": "column",
    "style": {
      "minHeight": "100%",
      "padding": 30,
      "background": { "light": "#fdfbf7", "dark": "#191816" },
      "color": { "light": "#292524", "dark": "#f5f5f4" },
      "borderWidth": 1,
      "borderColor": { "light": "#eee8de", "dark": "#2a2724" },
      "borderRadius": 8
    },
    "children": [
      {
        "type": "row",
        "style": {
          "width": "100%",
          "align": "center",
          "gap": 10
        },
        "children": [
          {
            "type": "column",
            "style": {
              "background": { "light": "#fff7ed", "dark": "#2c1d15" },
              "borderWidth": 1,
              "borderColor": { "light": "#fed7aa", "dark": "#4a2d1d" },
              "borderRadius": 4,
              "paddingX": 7,
              "paddingY": 3,
              "align": "center",
              "justify": "center"
            },
            "children": [
              {
                "type": "text",
                "text": "{day.padded}",
                "style": {
                  "font": {
                    "family": "heading",
                    "size": 13,
                    "weight": 700,
                    "color": "brand.600"
                  }
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "{date}",
            "style": {
              "font": {
                "size": 12,
                "color": { "light": "#78716c", "dark": "#a8a29e" }
              }
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "{body}",
        "style": {
          "flex": 1,
          "marginTop": 24,
          "font": {
            "size": 15,
            "lineHeight": 1.8
          }
        }
      },
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "end",
          "align": "center",
          "marginTop": 24
        },
        "children": [
          {
            "type": "spacer",
            "style": {
              "width": 16,
              "height": 2,
              "background": "brand.500",
              "opacity": 0.45,
              "borderRadius": 1
            }
          }
        ]
      }
    ]
  }
}
