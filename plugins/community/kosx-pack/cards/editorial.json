{
  "specVersion": 1,
  "root": {
    "type": "column",
    "style": {
      "minHeight": "100%",
      "background": { "light": "#f6f5f0", "dark": "#17181a" },
      "color": { "light": "#111111", "dark": "#f5f5f7" },
      "borderWidth": 1,
      "borderColor": { "light": "#e2ded5", "dark": "#2a2b2e" },
      "borderRadius": 6
    },
    "children": [
      {
        "type": "column",
        "style": {
          "height": 3,
          "background": "brand.500"
        }
      },
      {
        "type": "row",
        "style": {
          "justify": "space-between",
          "align": "center",
          "paddingX": 28,
          "paddingTop": 22
        },
        "children": [
          {
            "type": "text",
            "text": "EDITORIAL",
            "style": {
              "font": {
                "family": "heading",
                "size": 10,
                "weight": 700,
                "letterSpacing": 1.6,
                "uppercase": true,
                "color": { "light": "#71717a", "dark": "#a1a1aa" }
              }
            }
          },
          {
            "type": "text",
            "text": "{date}",
            "style": {
              "font": {
