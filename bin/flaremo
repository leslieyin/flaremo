#!/usr/bin/env node

/**
 * FlareMo Memory Ledger CLI (v2)
 *
 * Lightweight, zero-daemon command-line interface for agents & humans.
 * Exit code contract:
 *   0: Success
 *   1: Command or validation error
 *   3: Memory service unreachable (offline fallback triggered)
 */

import { spawn } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

import { resolveCredentials, writeCredentialsFile } from "../harness/core/credentials.mjs";
import { emptyOutput, handleHook } from "../harness/core/hooks.mjs";
import { runImport } from "../harness/core/importer.mjs";
import {
  doctorCmd,
  initCmd,
  uninstallCmd,
  updateCmd,
} from "../harness/core/install.mjs";
import { enqueueOutbox, flushOutbox } from "../harness/core/outbox.mjs";
import { resolveProject } from "../harness/core/project.mjs";
import { flaremoHome } from "../harness/core/paths.mjs";
import {
  readSnapshot,
  recordLastWrite,
  writeSnapshot,
} from "../harness/core/state.mjs";
import { request } from "../harness/core/transport.mjs";

const HOME = flaremoHome(process.env);
const CRED = resolveCredentials(process.env, HOME);
const FLAREMO_URL = CRED.url;
const THIS_FILE = fileURLToPath(import.meta.url);

async function callMcp(toolName, args, command = "", { projectKey } = {}) {
  const res = await request(toolName, args, { env: process.env, home: HOME });

  if (res.unreachable) {
    handleUnreachable(res.error, command, projectKey);
    return undefined;
  }
  if (res.auth) {
    console.error(
      `❌ 鉴权失败 (${res.status})：检查 FLAREMO_PAT 是否已设置且未过期。`,
    );
    process.exit(1);
  }
  if (!res.ok) {
    if (res.toolError) {
      console.error(`❌ ${res.error}`);
    } else {
      console.error(
        res.error?.startsWith("MCP ")
          ? `FlareMo ${res.error}`
          : `FlareMo Error (${res.status}): ${res.error ?? ""}`,
      );
    }
    process.exit(1);
  }
  return res.data;
}

/**
 * `memory_recall` returns a list, and the MCP envelope normalizes a bare list
 * into `{ result: [...] }` to keep every tool answer an object. Unwrap that
 * shape so callers can treat recall like the array it conceptually is.
 */
function unwrapList(value) {
  if (Array.isArray(value)) return value;
  if (value && Array.isArray(value.result)) return value.result;
  return [];
}

/**
 * Exit codes are part of the agent contract (SKILL.md):
 *   0 — served live from the ledger
 *   0 + stderr `[离线模式]` — served from a local snapshot (the caller may
 *       proceed, but must not claim it consulted the current ledger)
 *   3 — no memory available at all: nothing live, nothing cached
 *   1 — bad arguments, auth failure, or a rejected tool call
 */
function handleUnreachable(error, command = "", projectKey) {
  const isLensCommand = ["lens", "bootstrap", "status"].includes(command);
  if (isLensCommand) {
    const cached = readSnapshot(HOME, projectKey ?? null);
    if (cached) {
      console.warn("⚠️ [离线模式] 记忆服务不可达，已降级使用缓存快照\n");
      console.log(cached);
      process.exit(0);
    }
  }
  console.error("❌ 错误：记忆服务不可达 (Service Unreachable)");
  console.error(
    `无法连接到 ${FLAREMO_URL}${isLensCommand ? "，且无本地缓存快照可用" : ""}。`,
  );
  process.exit(3);
}

/**
 * remember/checkpoint on unreachable: park the write in the local outbox so it
 * is replayed automatically once the service comes back.
 */
function enqueueWriteOrExit(toolName, args) {
  enqueueOutbox(HOME, {
    id: `outbox:${Date.now().toString(36)}:${Math.random().toString(36).slice(2, 10)}`,
    tool: toolName,
    args,
  });
  console.warn("⚠️ 记忆服务不可达，已暂存本地，恢复后自动补写");
  process.exit(3);
}

async function writeWithQueue(toolName, args, command, projectKey) {
  const res = await request(toolName, args, { env: process.env, home: HOME });
  if (res.unreachable) {
    enqueueWriteOrExit(toolName, args, projectKey);
    return undefined;
  }
  if (res.auth) {
    console.error(
      `❌ 鉴权失败 (${res.status})：检查 FLAREMO_PAT 是否已设置且未过期。`,
    );
    process.exit(1);
  }
  if (!res.ok) {
    console.error(`❌ ${res.error ?? `HTTP ${res.status}`}`);
    process.exit(1);
  }
  try {
    recordLastWrite(HOME, projectKey);
  } catch {}
  return res.data;
}

function parseCliArgs() {
  const args = process.argv.slice(2);
  const command = args[0];
  const options = {};
  const positional = [];

  for (let i = 1; i < args.length; i++) {
    const arg = args[i];
    if (arg.startsWith("--")) {
      const key = arg.slice(2).replace(/-/g, "_");
      const next = args[i + 1];
      const value = next && !next.startsWith("--") ? (i++, next) : true;
      // Repeatable flags (e.g. `checkpoint --item a --item b`) accumulate into
      // an array instead of silently overwriting earlier values.
      options[key] =
        options[key] === undefined
          ? value
          : Array.isArray(options[key])
            ? [...options[key], value]
            : [options[key], value];
    } else {
      positional.push(arg);
    }
  }

  return { command, positional, options };
}

/** Scalar options: last occurrence wins when a flag is repeated. */
const last = (v) => (Array.isArray(v) ? v[v.length - 1] : v);
/** Repeatable options: every occurrence is kept. */
const all = (v) => (v === undefined ? [] : Array.isArray(v) ? v : [v]);

/** The repo checkout this CLI came from ships the skill source next to it. */
function skillRepoPresent() {
  return existsSync(join(dirname(THIS_FILE), "..", "skills", "flaremo-memory", "SKILL.md"));
}

function readStdin(capMs = 2000) {
  return new Promise((resolve) => {
    let text = "";
    let done = false;
    const finish = () => {
      if (!done) {
        done = true;
        resolve(text);
      }
    };
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (chunk) => (text += chunk));
    process.stdin.on("end", finish);
    setTimeout(finish, capMs).unref();
    if (process.stdin.isTTY) finish();
  });
}

function spawnDetachedFlush() {
  try {
    const child = spawn(process.execPath, [THIS_FILE, "outbox", "flush"], {
      stdio: "ignore",
      detached: true,
      env: process.env,
    });
    child.on("error", () => {});
    child.unref();
  } catch {}
}

async function runHook(harness, event) {
  const stdinText = await readStdin(2000);
  let payload = {};
  try {
    const parsed = JSON.parse(stdinText);
    if (parsed && typeof parsed === "object") payload = parsed;
  } catch {
    // Garbage stdin is fine — the handler tolerates an empty payload.
  }

  const hardCap = setTimeout(() => {
    console.log(JSON.stringify(emptyOutput(harness, event)));
    process.exit(0);
  }, 4000);
  hardCap.unref();

  try {
    const { output, spawnFlush } = await handleHook(harness, event, payload, {
      env: process.env,
      home: HOME,
    });
    console.log(JSON.stringify(output));
    if (spawnFlush) spawnDetachedFlush();
  } catch {
    console.log(JSON.stringify(emptyOutput(harness, event)));
  }
  process.exit(0);
}

async function readPatFromStdin() {
  if (!process.stdin.isTTY) {
    const text = await readStdin(10_000);
    return text.trim();
  }
  // TTY: prompt with echo off (raw mode, chars not echoed).
  process.stderr.write("PAT: ");
  return await new Promise((resolve) => {
    let buf = "";
    const onData = (chunk) => {
      for (const ch of chunk.toString("utf8")) {
        if (ch === "\n" || ch === "\r") {
          cleanup();
          process.stderr.write("\n");
          resolve(buf.trim());
          return;
        }
        if (ch === "\u007f" || ch === "\b") {
          buf = buf.slice(0, -1);
        } else if (ch === "\u0003") {
          cleanup();
          process.stderr.write("\n");
          resolve("");
          return;
        } else {
          buf += ch;
        }
      }
    };
    const cleanup = () => {
      process.stdin.off("data", onData);
      try {
        process.stdin.setRawMode(false);
      } catch {}
      process.stdin.pause();
    };
    try {
      process.stdin.setRawMode(true);
    } catch {}
    process.stdin.resume();
    process.stdin.on("data", onData);
  });
}

async function main() {
  const { command, positional, options } = parseCliArgs();

  if (!command || command === "help" || command === "--help" || command === "-h") {
    printHelp();
    process.exit(0);
  }

  const agent = last(options.agent) || process.env.FLAREMO_AGENT || "cli";
  const projectKey =
    last(options.project) ||
    last(options.scope) ||
    resolveProject(process.cwd(), process.env);

  switch (command) {
    case "hook": {
      const harness = positional[0];
      const event = positional[1];
      await runHook(harness, event);
      return;
    }

    case "login": {
      const url = last(options.url) || CRED.url;
      let pat;
      if (options.from_env) {
        pat = process.env.FLAREMO_PAT || "";
        if (!pat) {
          console.error("❌ --from-env 需要 FLAREMO_PAT 已设置在环境中");
          process.exit(1);
        }
      } else {
        pat = await readPatFromStdin();
      }
      if (!pat) {
        console.error("❌ 未读到 PAT");
        process.exit(1);
      }
      const path = writeCredentialsFile(HOME, { url, pat });
      console.log(`✅ 凭据已写入 ${path}（0600）`);
      break;
    }

    case "init": {
      const harnesses = last(options.harness)
        ? String(last(options.harness)).split(",").map((s) => s.trim()).filter(Boolean)
        : null;
      await initCmd({ env: process.env, home: HOME, harnesses, dryRun: Boolean(options.dry_run) });
      break;
    }

    case "doctor":
    case "setup": {
      const problems = await doctorCmd({ env: process.env, home: HOME });
      if (problems > 0) process.exit(1);
      break;
    }

    case "uninstall": {
      const harnesses = last(options.harness)
        ? String(last(options.harness)).split(",").map((s) => s.trim()).filter(Boolean)
        : null;
      await uninstallCmd({ env: process.env, home: HOME, harnesses, dryRun: Boolean(options.dry_run) });
      break;
    }

    case "update": {
      await updateCmd({ env: process.env, home: HOME });
      break;
    }

    case "import": {
      const source = positional[0];
      if (!["zcode", "codex", "pi"].includes(source)) {
        console.error("用法: flaremo import <zcode|codex|pi> [--apply]");
        process.exit(1);
      }
      const apply = Boolean(options.apply);
      const result = await runImport(source, {
        apply,
        env: process.env,
        home: HOME,
      });
      console.log(`\n${source} 原生记忆：共 ${result.total} 条`);
      for (const [project, count] of Object.entries(result.perProject)) {
        console.log(`  ${project}: ${count} 条`);
      }
      if (result.samples.length) {
        console.log(`\n样本（前 ${result.samples.length} 条）:`);
        for (const s of result.samples) {
          console.log(`  [${s.project}] ${s.content}`);
        }
      }
      if (!apply) {
        console.log(`\n（dry-run，未发送；加 --apply 实际入账）`);
      } else {
        console.log(
          `\n已入账 ${result.sent} 条${result.skipped.length ? `，跳过 ${result.skipped.length} 条（服务端拒绝）` : ""}`,
        );
        for (const s of result.skipped.slice(0, 10)) {
          console.log(`  跳过: ${s.label} — ${s.reason}`);
        }
        if (result.unreachable) process.exit(3);
      }
      break;
    }

    case "outbox": {
      if (positional[0] !== "flush") {
        console.error("用法: flaremo outbox flush");
        process.exit(1);
      }
      const r = await flushOutbox(HOME, { env: process.env, budgetMs: 60_000 });
      if (!options.quiet) {
        console.log(`outbox: 已补写 ${r.sent}，保留 ${r.kept}，失败 ${r.failed}`);
      }
      break;
    }

    case "recall": {
      const query = positional[0];
      if (!query) {
        console.error("用法: flaremo recall <查询词> [--as-of YYYY-MM-DD] [--from-scope <scope>]");
        process.exit(1);
      }

      const results = unwrapList(
        await callMcp(
          "memory_recall",
          {
            query,
            agent,
            project_key: projectKey,
            from_scope: last(options.from_scope),
            fact_key: last(options.key),
            as_of: last(options.as_of),
            include_inferred: Boolean(options.include_inferred),
            limit: options.limit ? Number(last(options.limit)) : 8,
          },
          command,
          { projectKey },
        ),
      );

      if (results.length === 0) {
        console.log("未找到匹配的记忆。");
        return;
      }

      console.log(`\n🔍 召回结果 (${results.length} 条):\n`);
      for (const item of results) {
        const badge = item.verification === "locked" ? "📌 拍板" : item.verification === "confirmed" ? "✅ 确认" : item.verification === "observed" ? "👀 发现" : "💡 猜想";
        const paths = (item.match_paths || [item.matched_by]).join(",");
        console.log(`[${badge}] [命中: ${paths}] ${item.content}`);
        if (item.fact_key) console.log(`   └─ 事实键: ${item.fact_key}`);
        if (item.evidence && item.evidence.length > 0) {
          console.log(`   └─ 依据: ${item.evidence[0].excerpt || item.evidence[0].source_type}`);
        }
      }
      console.log();
      break;
    }

    case "remember": {
      const content = positional[0];
      if (!content) {
        console.error(
          "用法: flaremo remember <记忆内容> [--key <fact_key>] [--tags <tag1,tag2>] [--scope-type project|global]",
        );
        process.exit(1);
      }

      const tags = all(options.tags)
        .flatMap((v) => String(v).split(","))
        .map((s) => s.trim())
        .filter(Boolean);
      // Agents only ever write 👀 observed / 💡 inferred; promotion to ✅/📌 is a
      // human act. `idempotency_key` makes a retried call return the first row
      // instead of creating a twin.
      const writeKey =
        last(options.idempotency_key) ||
        process.env.FLAREMO_IDEMPOTENCY_KEY ||
        undefined;
      const result = await writeWithQueue(
        "memory_remember",
        {
          content,
          fact_key: last(options.key) || undefined,
          tags,
          type: last(options.type) || "semantic",
          kind: last(options.kind) || "fact",
          scope_type: last(options.scope_type) || (projectKey ? "project" : "global"),
          scope_key: projectKey || undefined,
          verification: "observed",
          source_agent: agent,
          idempotency_key: writeKey,
        },
        command,
        projectKey,
      );

      if (result?.duplicate) {
        console.log(`ℹ️ 已存在完全相同的内容 (ID: ${result.memory?.id})`);
      } else if (result?.memory) {
        const v = result.memory.verification;
        const msg =
          v === "inferred"
            ? "💡 已作为提案递交至审核箱 (需人类确认)"
            : "✅ 记忆已保存";
        console.log(`${msg} (ID: ${result.memory.id})`);
      } else {
        console.log("✅ 记忆已保存");
      }
      break;
    }

    case "checkpoint": {
      const summary = positional[0];
      if (!summary) {
        console.error("用法: flaremo checkpoint <战报摘要> [--item <原子结论>]...");
        process.exit(1);
      }

      const items = [];
      const rawItems = all(options.item).filter((v) => typeof v === "string");
      if (rawItems.length > 0) {
        for (const it of rawItems) {
          items.push({ content: it, type: "semantic", kind: "fact", importance: 60 });
        }
      } else {
        items.push({ content: summary, type: "semantic", kind: "fact", importance: 50 });
      }

      const result = await writeWithQueue("memory_checkpoint", {
        agent,
        project_key: projectKey,
        scope_type: "project",
        scope_key: projectKey,
        summary,
        items,
      }, command, projectKey);

      console.log(`🎯 战报历程已记录 (ID: ${result.episode?.id || "ok"})`);
      console.log(`   衍生原子结论: ${result.items?.length || 0} 条`);
      break;
    }

    case "lens":
    case "bootstrap": {
      // `lens` asks the server for the actual projection — the same bytes an
      // agent would receive — rather than re-rendering a client-side imitation.
      // Re-implementing the format here would drift from compileCoreMemory and
      // make "what does the agent see?" a guess again.
      const compiled = await callMcp(
        "memory_compile",
        {
          agent,
          project_key: projectKey,
          max_chars: options.max_chars ? Number(last(options.max_chars)) : 6000,
        },
        command,
        { projectKey },
      );

      if (!compiled?.system_prompt_payload) {
        console.log("当前项目无活跃随身锦囊。");
        return;
      }

      console.log(compiled.system_prompt_payload);
      console.log(
        `\n--- 预算: ${compiled.character_count} 字符 / ≈${compiled.estimated_tokens} tokens`,
      );
      if (compiled.pinned_overflow) {
        console.warn(
          "⚠️ 铁律本身已超出预算：本次只带了铁律，其余全部让位。",
        );
      } else if (compiled.has_overflow) {
        console.warn(
          `⚠️ 另有 ${compiled.truncated_items?.length ?? 0} 条因预算被裁。`,
        );
      }

      // Snapshot for the offline fallback (exit code 3 path).
      writeSnapshot(HOME, projectKey, compiled.system_prompt_payload);
      break;
    }

    case "status": {
      const result = await callMcp("memory_bootstrap", {
        agent,
        project_key: projectKey,
        max_items: 50,
      }, command, { projectKey });
      const items = result.items || [];
      console.log(`\n📌 活跃便签 (${items.length} 条) - Context: ${projectKey}\n`);
      for (const item of items) {
        const badge =
          item.verification === "locked"
            ? "📌 我拍板的"
            : item.verification === "confirmed"
              ? "✅ 我确认过"
              : item.verification === "observed"
                ? "👀 AI 发现"
                : "💡 AI 猜想";
        console.log(`• [${badge}] ${item.content}`);
      }
      console.log();
      break;
    }

    case "seed": {
      // Cold-start seeding (§VI.2, v2.4): a fresh project has no memories, so
      // scan the local README / AGENTS convention files and apply a handful of
      // candidate notes DIRECTLY as 👀 observed facts — they come from the
      // user's own repo docs, so confidence is high and grading each one is
      // busywork. Delete-on-sight replaces approve-or-reject: anything wrong
      // gets removed in one click from the memory page. Content is
      // deterministic (heading + leading sentence), and each candidate carries
      // an idempotency key derived from file identity so a re-run never
      // spawns duplicates.
      const sourceFiles = ["AGENTS.md", "README.md", "CLAUDE.md"].map((name) =>
        join(process.cwd(), name),
      );
      const candidates = [];
      for (const file of sourceFiles) {
        if (!existsSync(file)) continue;
        const text = readFileSync(file, "utf-8");
        const lines = text.split("\n");
        let section = null;
        let sectionBody = "";
        const flush = () => {
          if (!section) return;
          const sentence = sectionBody
            .split(/(?<=[。！?！？.!?])\s*/)
            .map((part) => part.trim())
            .find((part) => part.length >= 12 && part.length <= 300);
          if (sentence) {
            const slug = section
              .toLowerCase()
              .replace(/[^a-z0-9一-鿿]+/g, "-")
              .replace(/^-+|-+$/g, "")
              .slice(0, 40);
            candidates.push({
              content: sentence.trim(),
              fact_key: slug ? `${process.cwd().split("/").pop().toLowerCase()}.${slug}` : undefined,
              tags: [section.toLowerCase()],
              file,
            });
          }
          section = null;
          sectionBody = "";
        };
        for (const line of lines) {
          const heading = line.match(/^#{2,3}\s+(.{1,60})\s*$/);
          if (heading) {
            flush();
            section = heading[1].trim();
            continue;
          }
          if (section && line.trim() && !line.startsWith("#")) {
            sectionBody += ` ${line.trim()}`;
          }
        }
        flush();
        if (candidates.length >= 5) break;
      }

      const picked = candidates.slice(0, 5);
      if (picked.length === 0) {
        console.log("未在 README.md / AGENTS.md / CLAUDE.md 中找到可提炼的小节。");
        return;
      }

      let seeded = 0;
      for (const candidate of picked) {
        const result = await writeWithQueue("memory_remember", {
          content: candidate.content,
          fact_key: candidate.fact_key,
          tags: candidate.tags,
          type: "semantic",
          kind: "fact",
          scope_type: "project",
          scope_key: projectKey,
          verification: "observed",
          source_agent: agent,
          idempotency_key: `seed:${candidate.file}:${candidate.content.length}:${candidate.content.slice(0, 40)}`,
        }, command, projectKey);
        if (result?.memory || result?.duplicate) seeded += 1;
      }
      console.log(`\n🌱 冷启动:已把 ${seeded} 条便签直接生效为 👀 观察（来自你仓库自己的文档）。不对的到「记忆」页当场删除即可。\n`);
      break;
    }

    default:
      console.error(`未知命令: ${command}`);
      printHelp();
      process.exit(1);
  }

  // Best-effort outbox flush at the end of every normal command: bounded,
  // silent, never in the way.
  await flushOutbox(HOME, {
    env: process.env,
    budgetMs: 3000,
    timeoutMs: 2500,
  }).catch(() => {});
}

function printHelp() {
  console.log(`
FlareMo Memory Ledger CLI

用法:
  flaremo recall "查询词" [--as-of YYYY-MM-DD] [--from-scope <scope>]
  flaremo remember "记忆正文" [--key <fact_key>] [--tags <tag1,tag2>]
  flaremo checkpoint "本次战报摘要" [--item "原子结论"]
  flaremo lens [--scope <project>]
  flaremo status
  flaremo seed                # 冷启动：扫描 README/AGENTS 提炼候选便签（直接 👀 生效）

接入与维护:
  flaremo login --url <实例地址>   # 写凭据到 ~/.flaremo/credentials（PAT 从 stdin/提示读入，不回显）
  flaremo login --from-env         # 把当前 FLAREMO_URL/FLAREMO_PAT 落进凭据文件
  flaremo init [--harness zcode,codex,antigravity,pi] [--dry-run]
  flaremo doctor                  # 自检：凭据/连通/鉴权/插件与原生记忆开关（setup 为旧名）
  flaremo uninstall [--harness …] # 还原备份、摘除软链与插件
  flaremo update                  # git pull --ff-only + 刷新 codex marketplace + 重建 hook 包装
  flaremo import <zcode|codex|pi> [--apply]   # 原生记忆搬家（默认 dry-run 只打印计数与样本）
  flaremo outbox flush            # 冲刷本地待补写队列
  flaremo hook <zcode|codex|antigravity> <event>   # Harness 生命周期钩子（读 stdin JSON）

选项:
  --project, --scope  当前项目标识 (默认 FLAREMO_PROJECT → git 根 → 工作目录)
  --agent             调用 Agent 名称 (默认 'cli')
  --as-of             时态穿梭：查询历史某天成立的事实
  --from-scope        显式跨项目翻阅
  --key               指定确定性事实键 (fact_key)
  --tags              话题标签列表 (以逗号分隔)

退出码:
  0: 成功
  1: 参数错误
  3: 记忆服务不可达 (已暂存本地或降级快照)
`);
}

main().catch((err) => {
  console.error("Fatal error:", err);
  process.exit(1);
});
