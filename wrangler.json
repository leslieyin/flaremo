{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flaremo",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/file/*",
      "/mcp",
      "/memory/*",
      "/openapi.json",
      "/memos.api.v1.*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flaremo",
      "database_id": "85afda7e-84f4-4506-b1d7-9d9d91063c09",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "flaremo-attachments",
      "preview_bucket_name": "flaremo-attachments"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MEMBER_REMOVAL_QUEUE",
        "queue": "flaremo-member-removal"
      },
      {
        "binding": "DATA_EXPORT_QUEUE",
        "queue": "flaremo-data-export"
      }
    ],
    "consumers": [
      {
        "queue": "flaremo-member-removal",
        "max_batch_size": 10,
        "max_retries": 5
      },
      {
        "queue": "flaremo-data-export",
        "max_batch_size": 5,
        "max_retries": 5
      }
    ]
  },
  "vectorize": [
    {
      "binding": "VECTORIZE_MEMOS",
      "index_name": "flaremo-memos"
    },
    {
      "binding": "VECTORIZE_MEMORIES",
      "index_name": "flaremo-memories"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "vars": {
    "FLAREMO_DEPLOY_REPOSITORY": "leslieyin/FlareMo",
    "FLAREMO_SINGLE_USER_EMAIL": "owner@flaremo.local",
    "FLAREMO_SINGLE_USER_NAME": "FlareMo Owner",
    "FLAREMO_PUBLIC_URL": "https://flaremo.example.workers.dev",
    "FLAREMO_TRUSTED_ORIGINS": "https://flaremo.yhz610323.workers.dev",
    "FLAREMO_EMBEDDING_PROVIDER": "workers-ai",
    "FLAREMO_EMBEDDING_MODEL": "@cf/qwen/qwen3-embedding-0.6b",
    "FLAREMO_EMBEDDING_DIMENSIONS": "1024",
    "FLAREMO_VECTORIZE_STORED_LIMIT": "5000000",
    "FLAREMO_VECTORIZE_QUERIED_LIMIT": "30000000"
  }
}
