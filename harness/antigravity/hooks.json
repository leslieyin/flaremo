{
  "flaremo-memory": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"$HOME/.flaremo/bin/flaremo-hook\" antigravity pre-invocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$HOME/.flaremo/bin/flaremo-hook\" antigravity stop",
        "timeout": 10
      }
    ]
  }
}
