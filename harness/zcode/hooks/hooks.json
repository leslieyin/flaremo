{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.flaremo/bin/flaremo-hook\" zcode session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.flaremo/bin/flaremo-hook\" zcode user-prompt",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.flaremo/bin/flaremo-hook\" zcode stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
