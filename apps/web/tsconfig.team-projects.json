{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.team-projects.tsbuildinfo",
    "allowJs": true,
    "checkJs": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/features/team-projects"],
  "exclude": ["src/features/team-projects/**/*.test.ts"]
}
